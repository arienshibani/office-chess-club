# Preconfigured environment for local Docker development.
# Used automatically by compose.yml — no manual .env setup required.
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DB_NAME=chess-club
SESSION_SECRET=local-dev-session-secret-at-least-32-characters-long
ORIGIN=http://localhost:5173
SLACK_WEBHOOK_URL= # Optional Slack channel webhook URL.
DISCORD_WEBHOOK_URL= # Optional Discord channel webhook URL.
AUTO_PROMOTE_FIRST_USER=true

# Dev seed (docker/app-entrypoint.sh): admin/admin + test users (password: password)
# Reset sample data: docker compose down -v && just start
