# Production image for Office Chess Club (SvelteKit + adapter-node).
# Published to GHCR on merges to main. Run with runtime env (MONGODB_URI, SESSION_SECRET, etc.).
FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/* \
	&& corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

COPY . .

# Placeholders for $env/static/private at build time — override via container env at runtime.
ENV SVELTEKIT_ADAPTER=node \
	SESSION_SECRET=build-placeholder-secret-minimum-32-characters \
	MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0 \
	ORIGIN=http://localhost:3000 \
	SLACK_WEBHOOK_URL=https://example.com/slack \
	DISCORD_WEBHOOK_URL=https://example.com/discord

RUN pnpm build

FROM node:22-bookworm-slim AS production

WORKDIR /app

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/* \
	&& corepack enable

ENV NODE_ENV=production \
	PORT=3000 \
	HOST=0.0.0.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY --from=build /app/build ./build
COPY --from=build /app/node_modules ./node_modules

EXPOSE 3000

CMD ["node", "build"]
